{
  "name": "joi-doorway-video",
  "version": "1.0.0",
  "description": "Remotion source videos for the Joi Doorway personal-site intro.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.484",
    "@remotion/tailwind-v4": "4.0.484",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.484",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:intro": "remotion render IntroPhone ../assets/intro-phone.mp4 --codec=h264 --concurrency=1",
    "render:peephole": "remotion render PeepholeJoi ../assets/peephole-joi.mp4 --codec=h264 --concurrency=1",
    "render:preview": "remotion render DoorwayPreview out/doorway-preview.mp4 --codec=h264 --concurrency=1",
    "render:reel-joi": "remotion render JoiReel out/reel-joi.mp4 --codec=h264 --concurrency=1",
    "render:reel-joi-map": "remotion render JoiMapReel out/reel-joi-map.mp4 --codec=h264 --concurrency=1"
  },
  "sideEffects": [
    "*.css"
  ]
}
